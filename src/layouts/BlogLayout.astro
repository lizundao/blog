---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Prose from '@/components/shared/Prose.astro';
import AuthorCard from '@/components/blog/AuthorCard.astro';
import { formatDate } from '@/lib/posts';
import { resolveOgImage } from '@/lib/seo';
import { resolveImage } from '@/lib/images';
import { site } from '@/config/site';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  cover?: string;
  /** 幽明栏目专用：古籍出处，如《太平广记》卷四四二 */
  source?: string;
  /** 幽明栏目专用：妖怪本名 */
  beast?: string;
}

const { title, description, pubDate, tags, cover, source, beast } = Astro.props;

// 标题里已经点了名的，就不再重复标一次
const showBeast = Boolean(beast && !title.includes(beast));

const coverMeta = resolveImage(cover);
const shareImage = await resolveOgImage(coverMeta ?? cover, Astro.site!);

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  author: {
    '@type': 'Person',
    name: site.author.name,
  },
  image: shareImage,
  url: Astro.url.href,
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={shareImage}
  ogType="article"
  publishedTime={pubDate}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <article class="section-shell py-10 sm:py-14">
    <header class="mb-8 max-w-3xl border-b border-border pb-8 lg:mb-10">
      <h1 class="text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl">{title}</h1>
      <p class="mt-4 text-base leading-relaxed text-muted-foreground">{description}</p>
      {
        (showBeast || source) && (
          <p class="mt-4 flex flex-wrap items-center gap-2 font-poem text-sm text-primary/85">
            {showBeast && <span>{beast}</span>}
            {showBeast && source && <span class="text-border">·</span>}
            {source && <span>{source}</span>}
          </p>
        )
      }
      <div class="mt-6 flex flex-wrap items-center gap-3 font-mono text-xs text-muted-foreground">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          tags.map((tag) => (
            <span class="tag-pill">{tag}</span>
          ))
        }
      </div>
    </header>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-12">
      <div class="min-w-0 max-w-3xl">
        <div class="mb-8 lg:hidden">
          <AuthorCard variant="compact" />
        </div>
        <Prose>
          <slot />
        </Prose>
      </div>

      <aside class="hidden lg:sticky lg:top-24 lg:block lg:self-start">
        <AuthorCard />
      </aside>
    </div>
  </article>
</BaseLayout>
